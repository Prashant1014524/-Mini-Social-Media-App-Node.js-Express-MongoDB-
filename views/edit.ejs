
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
<div class="w-full min-h-screen bg-zinc-900 text-white p-10">

    <!-- Back Button -->
    <a href="/profile" class="text-blue-500 mb-5 inline-block">
        ← Back to Profile
    </a>

    <!-- Heading -->
    <h3 class="text-2xl mb-5">
        Edit your post
    </h3>

    <!-- Form -->
    <form action="/update/<%= post._id %>" method="post" class="flex flex-col gap-4">

        <textarea 
            name="content"
            class="w-1/3 resize-none bg-transparent border border-zinc-700 rounded-lg p-3 outline-none focus:border-yellow-500"
            rows="4"
        ><%= post.content %></textarea>

        <button 
            type="submit"
            class="w-32 bg-yellow-500 hover:bg-yellow-600 text-black px-4 py-2 rounded-lg">
            Update Post
        </button>

    </form>
</div>
</body>
</html>