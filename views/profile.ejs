<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
<div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    <div class="w-full flex justify-end">
        <a class= " bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block " href="/logout">Logout</a>
    </div>
   <h3 class="text-3xl mb-3">
    <span class="font-light">Hello</span>, 
    <%= user.username %> 👋
</h3>

    <h5 class="mb-5 text-zinc-300">
        you can create a new post.
    </h5>

    <!-- Form -->
    <form action="/post" method="POST" class="flex flex-col gap-4">
        
        <textarea 
            name="content"
            placeholder="What's on your mind ?"
            class="w-1/3 resize-none bg-transparent border border-zinc-700 rounded-lg p-3 outline-none focus:border-blue-500"
            rows="4"
        ></textarea>

        <button 
            type="submit"
            class="w-32 bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg">
           create new post 
        </button>

    </form>
    <div class="posts mt-20">
    
    <h3 class="text-zinc-400 text-xl">Your Posts.</h3>

    <div class="postcontainer mt-5 flex flex-col gap-5">
          <% user.posts.forEach(function(post){ %>

            <div class="post w-1/3 p-4 rounded-md border-2 border-zinc-700 bg-zinc-800">
                <!-- Username -->
                <h4 class="text-blue-500 mb-2">
                @<%=user.username%>
                </h4>

                <!-- Post Content -->
                <p class="text-sm tracking-tight">
                 <%=post.content%>
                </p>

                <!-- Buttons -->
                 <small class="mt-4 inline-block"><%=post.likes.length%>likes</small>
                <div class="btns flex gap-4 mt-1">
                    <a class="text-blue-500" href="/like/<%=post._id%>">
                       <%=post.likes.indexOf(user._id)==-1?"like" :"Unlike"%>
                    </a>
                    <a class="text-zinc-400" href="/edit/<%=post._id%>">
                        Edit
                    </a>
                      <a class="text-red-500" href="/delete/<%= post._id %>">
        Delete
    </a>
                </div>

            </div>
            <%})%>
    </div>

</div>
</div>
</body>
</html>